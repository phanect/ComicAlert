<div class="hero-unit">
	<h2>All Comics</h2>
	<%- linkTo('Create a new Comic', addComicPath, {class: 'btn pull-right'}); %>
</div>

<div id="comics-list">
	<% if (comics) { %>
	<% for (var i = 0, ii = comics.length; i < ii; i++) { %>
	<div class="row list-item" id="comic-<%= comics[i].id; %>">
		<div class="span8">
			<h3><%- linkTo(comics[i].title, comicPath(comics[i].id)); %></h3>
		</div>
		<div class="span4">
			<h3><i class="icon-list-alt"></i><%= comics[i].id; %></h3>
		</div>
	</div>
	<% } %>
	<% } %>
</div>