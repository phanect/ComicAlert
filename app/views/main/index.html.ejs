<h2>新着</h2>
<div id="episodes-list" class="container-fluid">
	<div class="row-fluid">
		<% if (episodes) { %>
			<% for (var i = 0, ii = episodes.length; i < ii; i++) { %>
				<%- partial("templates/comiccard", {comics : comics, episodes : episodes, i : i}) %>
			<% } %>
		<% } else {%>
			<p>未読のコミックはありません。</p>
		<% } %>
	</div>
</div>
