<h2>新着</h2>
<div id="episodes-list" class="container-fluid">
	<% if (episodes) { %>
	<% for (var i = 0, ii = episodes.length; i < ii; i++) { %>
	<div class="row-fluid list-item" id="episode-<%= episodes[i].id; %>">
		<div class="col-md-2 episode">
			<p><a href="<%- comics[i].url %>" target="_blank"><%-comics[i].title %></a></p>
			<p>
				<a href="<%- comics[i].url -%>" target="_blank"><img alt="" src="<%- (comics[i].thumbnailUrl) ? comics[i].thumbnailUrl : "/img/noimage.png" %>" width="118" height="118" ></a>
			</p>
			<p>
				<a href="<%- episodes[i].url %>" target="_blank">
					<%- episodes[i].name +
						((episodes[i].subTitle) ? " " + episodes[i].subTitle : "") +
						" " + episodes[i].formattedPublishedAt() + "~" +
						((episodes[i].availableUntil) ? episodes[i].formattedAvailableUntil() : "") %>
				</a>
			</p>
		</div>
	</div>
	<% } %>
	<% } else {%>
		<p>未読のコミックはありません。</p>
	<% } %>
</div>

