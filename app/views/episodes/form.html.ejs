<div class="control-group">
	<label for="name" class="control-label">name</label>
	<div class="controls">
		<%- contentTag('input', episode.name, {type:'text', class:'span6', name:'name'}) %>
	</div>
</div>
<div class="control-group">
	<label for="number" class="control-label">number</label>
	<div class="controls">
		<%- contentTag('input', episode.number, {type:'number', class:'span2', name:'number'}) %>
	</div>
</div>
<div class="control-group">
	<label for="subTitle" class="control-label">subTitle</label>
	<div class="controls">
		<%- contentTag('input', episode.subTitle, {type:'text', class:'span6', name:'subTitle'}) %>
	</div>
</div>
<div class="control-group">
	<label for="updatedAt" class="control-label">updatedAt</label>
	<div class="controls">
		<%- contentTag('input', episode.updatedAt, {type:'datetime', class:'span3', name:'updatedAt'}) %>
	</div>
</div>
<div class="control-group">
	<label for="expireAt" class="control-label">expireAt</label>
	<div class="controls">
		<%- contentTag('input', episode.expireAt, {type:'datetime', class:'span3', name:'expireAt'}) %>
	</div>
</div>
<div class="control-group">
	<label for="hasRead" class="control-label">hasRead</label>
	<div class="controls">
		<select name="hasRead", class="span1">
			<% if(episode.hasRead) { -%>
			<option>false</option>
			<option selected>true</option>
			<% } else { -%>
			<option selected>false</option>
			<option>true</option>
			<% } -%>
		</select>
	</div>
</div>
