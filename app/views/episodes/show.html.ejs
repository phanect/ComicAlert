<div class="hero-unit">
  <h2 class="name"><%= episode.name %></h2>
  <%- linkTo('Edit this episode', editEpisodePath(params.id), {class: 'btn pull-right'}); %>
  <%- linkTo('Back to list', episodePath(''), {class: 'btn pull-right'}); %>
</div>

<h2>Episode Properties</h2>
<% for(var i in episode) { -%>
<% if(i !== 'saved') { -%>
<div class="row list-item">
  <div class="span4">
    <h3><%= i %></h3>
  </div>
  <div class="span8">
    <h3><i class="icon-list-alt"></i><span class="<%= i %>"><%= episode[i] %></span></h3>
  </div>
</div>
<% } -%><% } -%>