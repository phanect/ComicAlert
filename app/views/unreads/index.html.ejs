<div class="hero-unit">
	<h2>All Unreads</h2>
	<%- linkTo('Create a new Unread', addUnreadPath, {class: 'btn pull-right'}); %>
</div>

<div id="unreads-list">
	<% if (unreads) { %>
	<% for (var i = 0, ii = unreads.length; i < ii; i++) { %>
	<div class="row list-item" id="unread-<%= unreads[i].id; %>">
		<div class="span8">
			<h3><%- linkTo(unreads[i].id, unreadPath(unreads[i].id)); %></h3>
		</div>
		<div class="span4">
			<h3><i class="icon-list-alt"></i><%= unreads[i].id; %></h3>
		</div>
	</div>
	<% } %>
	<% } %>
</div>