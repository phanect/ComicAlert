{
  "compilerOptions": {
    "alwaysStrict": true,
    "declaration": false,
    "target": "ES2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "DOM",
      "esnext"
    ],
    "newLine": "lf",
    "preserveConstEnums": true,
    "removeComments": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "strict": true,
    "strictNullChecks": false
  },
  "exclude": [ "node_modules" ]
}
