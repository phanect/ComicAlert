{
  "compilerOptions": {
    "alwaysStrict": true,
    "declaration": false,
    "esModuleInterop": true,
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": [
      "DOM",
      "esnext",
      "esnext.AsyncIterable",
    ],
    "newLine": "lf",
    "noEmit": true,
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "typeRoots": [
      "./node_modules/@types",
      "types"
    ],
    "strict": true
  },
  "exclude": [ "node_modules" ]
}
