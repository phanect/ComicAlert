{
  "name": "ComicAlert",
  "description": "Comic update notifier",
  "version": "0.0.1",
  "author": "Jumpei Ogawa @phanect",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/phanect/ComicAlert.git"
  },
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "clean": "git clean -dX --force && rm --force package-lock.json modules/crawler/package-lock.json modules/frontend/package-lock.json",
    "lint": "eslint --ext=.js,.jsx,.ts,.tsx . && lerna run lint",
    "reinstall": "yarn run clean && yarn install"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^2.5.0",
    "@lerna-lite/run": "^2.5.0",
    "eslint": "latest",
    "eslint-config-phanective": "latest",
    "typescript": "^3.2.4"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}
