{
  "name": "ComicAlert",
  "description": "Comic update notifier",
  "version": "0.0.1",
  "author": "Jumpei Ogawa @phanect",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/phanect/ComicAlert.git"
  },
  "scripts": {
    "build": "lerna run build",
    "clean": "git clean -dX --force && rm --force yarn.lock modules/crawler/yarn.lock modules/frontend/yarn.lock",
    "lint": "eslint --ext '.js,.ts' . && lerna run lint",
    "reinstall": "yarn run clean && yarn install",
    "postinstall": "lerna bootstrap"
  },
  "devDependencies": {
    "@phanect/eslint-plugin": "latest",
    "eslint": "latest",
    "lerna": "3.13.0",
    "typescript": "3.3.3"
  },
  "engines": {
    "node": "^10.0.0",
    "npm": "^6.0.0"
  }
}
