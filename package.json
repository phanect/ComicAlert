{
  "name": "ComicAlert",
  "description": "Comic update notifier",
  "version": "0.0.1",
  "author": "Jumpei Ogawa @phanect",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/phanect/ComicAlert.git"
  },
  "scripts": {
    "build": "lerna run build",
    "clean": "git clean -dX --force && rm --force package-lock.json modules/crawler/package-lock.json modules/frontend/package-lock.json",
    "lint": "eslint --ext=.js,.jsx,.ts,.tsx . && lerna run lint",
    "reinstall": "npm run clean && npm install",
    "postinstall": "lerna bootstrap"
  },
  "devDependencies": {
    "@phanect/eslint-plugin": "latest",
    "eslint": "latest",
    "eslint-plugin-nuxt": "^2.0.0",
    "lerna": "^3.10.7",
    "typescript": "^3.2.4"
  },
  "engines": {
    "node": "^16.0.0",
    "npm": "^7.0.0"
  }
}
